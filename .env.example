# StyleSense Environment Variables
PROJECT_NAME="StyleSense"
ENVIRONMENT="development"
DEBUG=true

# Server
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database (SQLite default for local development, PostgreSQL compatible)
DATABASE_URL="sqlite:///./stylesense.db"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# File Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5

# Optional LLM API Key (Strictly optional; local deterministic fallback is active by default)
OPENAI_API_KEY=""

# Authentication: export these into the backend process environment.
# Generate a stable random secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do not reuse example values or commit your actual secret.
AUTH_SECRET_KEY=
AUTH_ACCESS_SECONDS=300
AUTH_REFRESH_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_PASSWORD_COMPLEXITY=true
AUTH_LOGIN_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=900
APP_PUBLIC_URL=http://127.0.0.1:5173

# Local mode writes private JSON messages under backend/.dev-mail.
# There is no public outbox endpoint and no real email delivery in this mode.
AUTH_EMAIL_MODE=outbox
# AUTH_OUTBOX_DIR=/absolute/private/stylesense-outbox
# Optional real provider. Production requires smtp + SMTP_HOST.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@stylesense.example.com
SMTP_USERNAME=
SMTP_PASSWORD=

# Never enable demo seeding in production. Passwords must satisfy policy.
SEED_DEMO_ACCOUNTS=false
DEMO_CUSTOMER_PASSWORD=
DEMO_PRODUCT_MANAGER_PASSWORD=
DEMO_OPERATIONS_MANAGER_PASSWORD=
DEMO_ADMIN_PASSWORD=
# Optional email overrides; defaults are role@stylesense.example.com.
# DEMO_CUSTOMER_EMAIL=customer@stylesense.example.com
# DEMO_PRODUCT_MANAGER_EMAIL=product_manager@stylesense.example.com
# DEMO_OPERATIONS_MANAGER_EMAIL=operations_manager@stylesense.example.com
# DEMO_ADMIN_EMAIL=admin@stylesense.example.com

# First administrator only: python -m app.bootstrap_admin (pending verification).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# Compose local demo catalogue; production image default is false.
SEED_CATALOGUE_ON_START=true
