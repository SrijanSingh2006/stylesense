# StyleSense Environment Variables
PROJECT_NAME="StyleSense"
ENVIRONMENT="development"
DEBUG=true

# Server
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Database (SQLite default for local development, PostgreSQL compatible)
DATABASE_URL="sqlite:///./stylesense.db"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# File Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5

# Optional LLM API Key (Strictly optional; local deterministic fallback is active by default)
OPENAI_API_KEY=""
